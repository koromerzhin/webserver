# Exemple de configuration pour webserver — copier vers `.env` puis ajuster :
#   cp .env.example .env
# Le `.env` réel (mots de passe, JWT) ne doit JAMAIS être committé.

# Projet (requis par `task env:validate`)
PROJECT_NAME=webserver
ENVIRONMENT=development

# Stack Swarm (adaptez à votre machine : `docker info -f '{{.Swarm.NodeAddr}}'`)
STACK=webserver
IPSWARM=10.20.0.0/16
NETWORKS=proxywebserver,serverwebserver
ADVERTISEADDR=192.168.1.46

# Base de données (changez ces valeurs ! doivent correspondre aux seeds
# mariadb_init/*.sql au premier démarrage)
MYSQL_ROOT_PASSWORD=change_me_mysql_root
REDMINE_DB_PASSWORD=change_me_redmine
MYSQL_PASSWORD=change_me_nextcloud
NEXTCLOUD_ADMIN_PASSWORD=change_me_nextcloud_admin

# Configuration Mercure (générez des clés dédiées, ex. `openssl rand -hex 32`)
MERCURE_PUBLISHER_JWT_KEY=!ChangeThisMercureHubJWTSecretKey!
MERCURE_SUBSCRIBER_JWT_KEY=!ChangeThisMercureHubJWTSecretKey!

# Timezone
TZ=Europe/Paris
